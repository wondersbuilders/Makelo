# ---------- Domains ----------
# free subdomains: <app>.makelo.com
SITES_DOMAIN=makelo.com
# the builder + accounts
APP_HOST=app.makelo.com
# customers CNAME their subdomain here
CNAME_TARGET=sites.makelo.com
# your VPS public IP (customers' apex A record)
SERVER_IPV4=203.0.113.10
PUBLIC_SCHEME=https

# ---------- Certificates ----------
ACME_EMAIL=you@example.com
# Cloudflare API token with Zone:DNS:Edit on makelo.com (for the wildcard certificate)
CLOUDFLARE_API_TOKEN=

# ---------- Cloud sandboxes (where users' apps run while they build) ----------
# cloud = e2b.dev microVMs (recommended); webcontainer = StackBlitz in-browser (needs a StackBlitz licence)
SANDBOX_MODE=cloud
# From https://e2b.dev/dashboard
E2B_API_KEY=
# Build once with: cd platform && E2B_API_KEY=... node scripts/build-e2b-template.js
E2B_TEMPLATE=makelo-node
# Idle minutes before a sandbox pauses (paused = no compute cost, files kept)
SANDBOX_IDLE_MINUTES=10
# Sandbox time allowed per user per month in seconds (0 = unlimited; 36000 = 10 hours)
SANDBOX_MONTHLY_SECONDS=0

# ---------- Limits ----------
MAX_DEPLOY_MB=50
MAX_SITES_PER_USER=20
SESSION_DAYS=30

# ---------- AI providers (your keys = your bill; users can also add their own in Settings) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPEN_ROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
