# ---------- Domains ----------
# free subdomains: <app>.clickmyapp.com
SITES_DOMAIN=clickmyapp.com
# the builder + accounts
APP_HOST=app.clickmyapp.com
# customers CNAME their subdomain here
CNAME_TARGET=sites.clickmyapp.com
# your VPS public IP (customers' apex A record)
SERVER_IPV4=203.0.113.10
PUBLIC_SCHEME=https

# ---------- Certificates ----------
ACME_EMAIL=you@example.com
# Cloudflare API token with Zone:DNS:Edit on clickmyapp.com (for the wildcard certificate)
CLOUDFLARE_API_TOKEN=

# ---------- Limits ----------
MAX_DEPLOY_MB=50
MAX_SITES_PER_USER=20
SESSION_DAYS=30

# ---------- AI providers (your keys = your bill; users can also add their own in Settings) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPEN_ROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
